schema_version = 3
kind = behavior
id = behavior.a_context_practice.sentry
behavior_kind = finite_modes
target_x_mm = -4500
target_z_mm = -1500
stop_distance_mm = 80
dominated_actions = [pressure, recover]
initial_mode = pressure

[mode]
key = pressure
intent = hold
action = pressure
start_after_ms = 700
repeat_after_ms = 5500

[mode]
key = recover
intent = hold
action = recover
start_after_ms = 350
repeat_after_ms = 1000

[transition]
mode = pressure
order = 1
condition = own_resource/v1
comparison = lt
value = 12
after_ms = 100
next = recover

[transition]
mode = recover
order = 1
condition = own_resource/v1
comparison = ge
value = 72
after_ms = 2000
next = pressure
