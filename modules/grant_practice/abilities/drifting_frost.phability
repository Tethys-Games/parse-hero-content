# The same movement effect through an ordinary seeking delivery.
ability drifting_frost

[program]
execution = staged
category = utility

[activation]
kind = cast
cost = 0
cooldown_ms = 8000
cast_ms = 400

[target]
kind = actor
relation = hostile
range_metric = body_midpoint_3d
range_mm = 12000

[delivery]
kind = seeking
speed_mm_per_second = 6000
radius_mm = 100
lifetime_ms = 5000

[payload]
operation = apply_effect
effect = effect.slow

[presentation]
windup = beam
flight = orb
impact = flash
tint = cyan
