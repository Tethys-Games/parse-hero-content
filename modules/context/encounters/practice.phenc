encounter/v13 practice

[spawn]
placement = encounter_placement.advancer
npc_template = npc.advancer
stable_actor_key = actor.practice_advancer

[spawn]
placement = encounter_placement.left_sentry
npc_template = npc.sentry
stable_actor_key = actor.practice_left_sentry

[spawn]
placement = encounter_placement.right_sentry
npc_template = npc.sentry
stable_actor_key = actor.practice_right_sentry

# The ordinary encounter-action selector grants Possess; class binding restores the bar.

[ability possess]

execution = controlled_domination/v1
target = nearest_opponent/v1
cost = 0
cooldown_ms = 0
duration_ms = 6000
range_mm = 12000
source_linked = false

[ability return]

execution = end_domination/v1
target = own_override/v1
cost = 0
cooldown_ms = 0
duration_ms = 0
range_mm = 0
source_linked = false

[grant possess]

ability = possess
scope = participant
slot = 4
eligibility = avatar_only
retirement = cancel_now
resource_owner = actor_class/v1
context_access = none
lifetime = encounter
initial = false

[grant return]

ability = return
scope = override
slot = 4
eligibility = npc_only
retirement = cancel_now
resource_owner = actor_class/v1
context_access = none
lifetime = override
initial = false

[state/bounded_int phase_pulses]

maximum = 65535
initial = 0
reset = encounter/v1

# Players can escape two anchored tracking applications before any NPC has spawned.

[phase prelude]

initial = true
duration_ms = 20000
next = pressure
npc_placement = none
npc_ability = none
start_after_ms = 0
restart_after_ms = 0

# A phase and a sentry mode request the same immutable channel from the same actor.

[phase pressure]

initial = false
duration_ms = 12000
next = rest
spawn_placements = [encounter_placement.advancer, encounter_placement.left_sentry, encounter_placement.right_sentry]
spawn_after_ms = 1000
spawn_lifetime = encounter/v1
world_ability = raise_beacon
world_after_ms = 1400
world_placement = encounter_placement.advancer
npc_placement = encounter_placement.left_sentry
npc_ability = pressure
start_after_ms = 700
restart_after_ms = 6000

[phase rest]

initial = false
duration_ms = 8000
next = pressure
npc_placement = none
npc_ability = none
start_after_ms = 0
restart_after_ms = 0

# This changes the installed mode choice even during ordinary possession.

[phase_mode]
phase = pressure
order = 1
npc_placement = encounter_placement.left_sentry
behavior = behavior.sentry
mode = recover
after_ms = 3000

[phase_mode]
phase = pressure
order = 2
npc_placement = encounter_placement.left_sentry
behavior = behavior.sentry
mode = recover
after_ms = 9300

[phase_mode]
phase = rest
order = 1
npc_placement = encounter_placement.left_sentry
behavior = behavior.sentry
mode = pressure
after_ms = 1000

[phase_event]
event = channel_pulse/v1
field = phase_pulses

amount = 1

# One finite encounter pool. Phase changes do not refill it; Retry does.

[resource/bounded_int pressure_charge]

maximum = 168
initial = 168
reset = initial
ownership = encounter

# Slot 4 alternatives replace each other atomically; no additional initial grant.

[grant tracking]

definition = ability.tracking
scope = participant
slot = 4
eligibility = avatar_only
retirement = cancel_now
resource_owner = actor_class/v1
context_access = none
lifetime = encounter
initial = false

[grant secure_beacon]

definition = ability.interact
object = beacon
anchor = beacon_anchor
scope = participant
slot = 4
eligibility = avatar_only
retirement = cancel_now
resource_owner = actor_class/v1
context_access = public_object
lifetime = encounter
initial = false

[composition]
deadline_ms = 90000
completion = completed_object/v1
completion_object = beacon
after_completion = retain_for_retry/v1
failure = deadline_or_avatar_death/v1
reset = settle_owned_then_fresh_attempt/v1

# Exact public capability for the real advancing actor; no fifth kit or actor.

[class_context]
class = class.advancer
object = beacon

[object beacon]

phase = pressure
after_ms = 1000
x_mm = 0
z_mm = -1000
range_mm = 2000
required_progress = 3
anchor = beacon_anchor
completed_next = rest
access = public_interaction/v1
eligibility = live_avatar_in_range/v1
link_lifetime = exact_owned_generation/v1

[anchor beacon_anchor]

x_mm = 0
z_mm = -1000
capture = immutable_world_position/v1
support = canonical_destination/v1
missing = reject_no_retarget/v1

[anchor pressure_origin]

x_mm = 0
z_mm = -7500
capture = immutable_world_position/v1
support = canonical_destination/v1
missing = reject_no_retarget/v1

[executor ground_pressure]

definition = ability.tracking
origin_anchor = pressure_origin
origin_y_mm = 0
target_query = nearest_live_player_class_body/v1
resource = pressure_charge
cooldown_group = encounter_single/v1

[executor_schedule]
executor = ground_pressure
phase = prelude
order = 1
start_after_ms = 8000
repeat_after_ms = 8000
maximum_occurrences = 2

[executor_schedule]
executor = ground_pressure
phase = pressure
order = 2
start_after_ms = 4500
repeat_after_ms = 4000
maximum_occurrences = 2

[executor_schedule]
executor = ground_pressure
phase = rest
order = 3
start_after_ms = 2000
repeat_after_ms = 4000
maximum_occurrences = 1
