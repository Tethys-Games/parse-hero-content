behavior advancer

behavior_kind = finite_modes
target_xz_mm = (-1500, -3500)
stop_distance_mm = 120
initial_mode = advance
dominated_actions = [tracking, recover]

[mode.advance]
intent = move_to_point
action = none
start_after_ms = 0
repeat_after_ms = 0

[mode.pressure]
intent = hold
action = tracking
start_after_ms = 900
repeat_after_ms = 4000

[mode.recover]
intent = hold
action = recover
start_after_ms = 500
repeat_after_ms = 1200

[transition]
mode = advance
order = 1
condition = arrived
comparison = eq
value = true
after_ms = 100
next = pressure

# First matching guard wins. These two conditions are deliberately ordered.

[transition]
mode = pressure
order = 1
condition = own_resource
comparison = lt
value = 28
after_ms = 100
next = recover

[transition]
mode = pressure
order = 2
condition = elapsed
comparison = eq
value = true
after_ms = 18000
next = recover

[transition]
mode = recover
order = 1
condition = own_resource
comparison = ge
value = 84
after_ms = 2000
next = pressure
