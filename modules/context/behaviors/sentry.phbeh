behavior/v4 sentry

behavior_kind = finite_modes
target_x_mm = -4500
target_z_mm = -1500
stop_distance_mm = 80
initial_mode = pressure
dominated_actions = [pressure, recover]

[mode pressure]

intent = hold
action = pressure
start_after_ms = 700
repeat_after_ms = 5500

[mode recover]

intent = hold
action = recover
start_after_ms = 350
repeat_after_ms = 1000

# The positive elapsed fence is part of every guard, including resource guards.

[transition]
mode = pressure
order = 1
condition = own_resource/v1
comparison = lt
value = 12
after_ms = 100
next = recover

[transition]
mode = recover
order = 1
condition = own_resource/v1
comparison = ge
value = 72
after_ms = 2000
next = pressure
