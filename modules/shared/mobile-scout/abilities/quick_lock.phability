# Watch the moving guard before choosing the shorter lock and narrower ground circle.
ability/v3 quick_lock

defaults = combat_defaults/v1
resource_context = actor_bounded_int/v1
cooldown_context = actor_projectile/v1

[program]
execution = tracking_ground_area/v1
cast_ms = 1200
lock_ms = 400
cost = 30
cooldown_ms = 1800
amount = 52
movement_permille = 1000
target_range_mm = 9000
area_radius_mm = 700
area_height_mm = 1800
area_maximum_targets = 1
pre_lock_loss = cancel/v1
post_lock_loss = retain_ground/v1
empty_query = reject_unpaid/v1
miss = commit/v1
commitment = application/v1
application = ground_circle_damage/v1
