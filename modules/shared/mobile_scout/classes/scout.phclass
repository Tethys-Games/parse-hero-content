# Original mobile-scout practice kit: quick casts, tighter tracking, smaller reserve.
class/v17 scout

player_selectable = true

[resource.charge/bounded_int]
maximum = 60
initial = 60
reset = initial

# Action order is also installed action identity; formatting must preserve it.

[action.sidearm]
definition = ability.sidearm
cooldown_group = shared_actor/v1

[action.recharge]
definition = ability.recharge

# A faster lock is paired with a smaller hit circle and costly committed miss.

[action.quick_lock]
definition = ability.quick_lock
cooldown_group = shared_actor/v1

[action.channel]
definition = training/ability.channel # Same immutable definition, this actor's charge and cooldown.
cooldown_group = shared_actor/v1

[binding.1]
action = sidearm

[binding.2]
action = recharge

[binding.3]
action = quick_lock

[binding.4]
action = channel
