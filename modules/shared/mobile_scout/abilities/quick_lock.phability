# Watch the moving guard before choosing the shorter lock and narrower ground circle.
ability quick_lock

[program]
execution = tracking_ground_area
cast_ms = 1200
lock_ms = 400
cost = 30
cooldown_ms = 1800
amount = 52
movement_permille = 1000
target_range_mm = 9000
area_radius_mm = 700
area_height_mm = 1800
area_maximum_targets = 1
pre_lock_loss = cancel
post_lock_loss = retain_ground
empty_query = reject_unpaid
miss = commit
commitment = application
application = ground_circle_damage
