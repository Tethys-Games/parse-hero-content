schema_version = 13
kind = encounter
id = encounter.training
action_kind = spawn_npc

[spawn]
placement = encounter_placement.guard
npc_template = npc.guard
stable_actor_key = actor.range_guard

[state]
key = pulses
type = bounded_int
maximum = 65535
initial = 0
reset = encounter/v1
ownership = encounter_instance/v1
arithmetic = checked_add/v1
overflow = fault_retire/v1

[phase]
key = pressure
initial = true
duration_ms = 60000
next = pressure
npc_placement = encounter_placement.guard
npc_ability = pressure
start_after_ms = 2500
restart_after_ms = 6500
schedule = finite_phase_cadence/v1
unavailable = skip_request/v1
exit = retire_unfinished_owned/v1

[phase_event]
event = channel_pulse/v1
field = pulses
operation = add/v1
amount = 1
owner = originating_phase/v1
